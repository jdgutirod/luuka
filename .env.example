# Configuración para levantar todo con Docker: docker compose up --build
# Copia este archivo como .env (en la raíz del proyecto) y ajusta los valores.

# Base de datos. Usa una contraseña sin caracteres especiales (@ : / ?), porque va dentro de una URL.
POSTGRES_USER=luuka
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=luuka

# Llave para firmar los tokens (obligatoria). Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-llave-segura

# Puertos en tu computador
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Opcionales (estos son los valores por defecto)
ACCESS_TOKEN_EXPIRE_MINUTES=30
MIN_TRANSACTION_AMOUNT=1000
MAX_TRANSACTION_AMOUNT=10000000
