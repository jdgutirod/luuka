# Copia este archivo como .env y ajusta los valores

# Conexión a PostgreSQL (driver psycopg 3)
# Formato: postgresql+psycopg://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/habi

# Puerto del servidor (solo aplica al ejecutar con: python -m app.main)
PORT=8000

# Llave para firmar los tokens JWT (obligatoria). Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-llave-segura

# Minutos de validez del token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=30
